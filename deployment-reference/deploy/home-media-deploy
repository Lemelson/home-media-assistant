#!/usr/bin/python3
"""Privileged fixed-path deploy driver; Git and project tests run unprivileged."""

import fcntl
import json
import os
import re
import subprocess
import time
from pathlib import Path

ROOT = Path('/opt/home-media')
REPO = ROOT / 'repository.git'
STATE = Path('/var/lib/home-media')


def healthy_release(revision, heartbeat, started):
    try:
        data = json.loads(heartbeat.read_text())
        return data.get('revision') == revision and data.get('time', 0) >= started
    except (OSError, ValueError, TypeError, AttributeError):
        return False


def run(*args, user=False, cwd=None):
    command = ['runuser', '-u', 'home-media', '--'] if user else []
    return subprocess.check_output(command + list(args), cwd=cwd, text=True, stderr=subprocess.STDOUT).strip()


def git(*args):
    return run('/usr/bin/git', '--git-dir=' + str(REPO), *args, user=True)


def switch(target):
    temporary = ROOT / 'next'
    temporary.unlink(missing_ok=True)
    temporary.symlink_to(target)
    temporary.replace(ROOT / 'current')


def main():
    os.umask(0o022)
    with open('/run/lock/home-media-deploy.lock', 'w') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
        git('fetch', '--prune', 'origin', 'refs/heads/main:refs/heads/main')
        sha = git('rev-parse', 'refs/heads/main')
        if not re.fullmatch('[0-9a-f]{40}', sha):
            raise RuntimeError('invalid_git_revision')
        release = ROOT / 'releases' / sha
        current = ROOT / 'current'
        previous = current.resolve() if current.is_symlink() else None
        if previous == release:
            print('unchanged', sha)
            return
        if (ROOT / ('failed-' + sha)).exists():
            raise RuntimeError('revision_previously_failed_requires_review')
        if not release.exists():
            run('install', '-d', '-o', 'home-media', '-g', 'home-media', '-m', '0755', str(release))
            archive = subprocess.Popen(['runuser', '-u', 'home-media', '--', '/usr/bin/git',
                                        '--git-dir=' + str(REPO), 'archive', sha], stdout=subprocess.PIPE)
            try:
                subprocess.run(['runuser', '-u', 'home-media', '--', 'tar', '-x', '-C', str(release)], stdin=archive.stdout, check=True)
            finally:
                archive.stdout.close()
            if archive.wait() != 0:
                raise RuntimeError('archive_failed')
        run('/usr/bin/python3', '-m', 'unittest', 'discover', '-s', 'tests', '-v', user=True, cwd=release)
        switched = time.time()
        switch(release)
        try:
            run('systemctl', 'restart', 'home-media-bot.service')
            for _ in range(35):
                time.sleep(1)
                heartbeat = STATE / 'heartbeat'
                if healthy_release(sha, heartbeat, switched):
                    run('systemctl', 'is-active', '--quiet', 'home-media-bot.service')
                    print('deployed', sha)
                    return
            raise RuntimeError('new_release_not_healthy')
        except Exception:
            (ROOT / ('failed-' + sha)).touch()
            if previous is not None:
                switch(previous)
                run('systemctl', 'restart', 'home-media-bot.service')
            else:
                run('systemctl', 'stop', 'home-media-bot.service')
            raise


if __name__ == '__main__':
    main()
